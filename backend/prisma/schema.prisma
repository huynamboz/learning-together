generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleName {
  LEARNER
  CONTENT_EDITOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum DeviceType {
  COMPUTER
  PHONE
  TABLET
  OTHER
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum PlanCode {
  FREE
  PRO
  PREMIUM
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum StorageProvider {
  S3
  R2
  LOCAL
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  QUARANTINED
  FAILED
  DELETED
}

enum UploadStatus {
  PENDING
  COMPLETED
  ABORTED
  EXPIRED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  LISTENING
  READING
  GRAMMAR
  VOCABULARY
  EXAM
  VIDEO
  WRITING
  BLOG
}

enum ImportStatus {
  PENDING
  VALIDATING
  READY_TO_IMPORT
  IMPORTING
  COMPLETED
  FAILED
  CANCELED
}

enum QuestionKind {
  LISTENING
  READING
  GRAMMAR
  VOCABULARY
}

enum AttemptContext {
  PRACTICE
  EXAM
  DICTATION
  VOCABULARY_REVIEW
  GAME
}

enum SrsState {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum ExamSessionStatus {
  ACTIVE
  SUBMITTED
  EXPIRED
  ABANDONED
}

enum WritingStatus {
  DRAFT
  SUBMITTED
  GRADING
  GRADED
  FAILED
}

enum CreditEntryType {
  GRANT
  CONSUME
  EXPIRE
  ADJUST
}

enum PostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  SYSTEM
  VOCABULARY_REVIEW
  STREAK
  GOAL
  COMMUNITY
  BILLING
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  CANCELED
  PAID
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(320)
  displayName        String              @db.VarChar(120)
  avatarAssetId      String?             @db.Uuid
  status             UserStatus          @default(ACTIVE)
  timezone           String              @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  locale             String              @default("vi-VN") @db.VarChar(16)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  identities         AuthIdentity[]
  sessions           Session[]
  devices            Device[]
  roles              UserRole[]
  entitlements       Entitlement[]
  auditLogs          AuditLog[]
  ownedMedia         MediaAsset[]        @relation("MediaOwner")
  uploadSessions     UploadSession[]     @relation("UploadCreator")
  createdContent     ContentItem[]       @relation("ContentCreator")
  updatedContent     ContentItem[]       @relation("ContentUpdater")
  contentVersions    ContentVersion[]
  importBatches      ImportBatch[]
  attempts           QuestionAttempt[]
  questionProgress   QuestionProgress[]
  notes              Note[]
  savedItems         SavedItem[]
  studySessions      StudySession[]
  srsCards           SrsCard[]
  examSessions       ExamSession[]
  writingSubmissions WritingSubmission[]
  creditEntries      AiCreditLedger[]

  @@index([status, createdAt])
}

model AuthIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String       @db.VarChar(255)
  passwordHash      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(255)
  deviceId         String?   @db.Uuid
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model Device {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  deviceHash  String     @db.VarChar(128)
  type        DeviceType
  browser     String?    @db.VarChar(120)
  label       String?    @db.VarChar(120)
  firstSeenAt DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())
  revokedAt   DateTime?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([userId, revokedAt])
}

model Role {
  id    String     @id @default(uuid()) @db.Uuid
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Plan {
  id           String        @id @default(uuid()) @db.Uuid
  code         PlanCode      @unique
  displayName  String        @db.VarChar(80)
  entitlements Entitlement[]
}

model Entitlement {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  planId      String            @db.Uuid
  status      EntitlementStatus @default(ACTIVE)
  startsAt    DateTime          @default(now())
  expiresAt   DateTime?
  sourceOrder String?           @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan              @relation(fields: [planId], references: [id])

  @@index([userId, status, startsAt, expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String   @db.VarChar(120)
  entity    String   @db.VarChar(120)
  entityId  String?  @db.VarChar(120)
  requestId String?  @db.VarChar(80)
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

model MediaAsset {
  id            String          @id @default(uuid()) @db.Uuid
  ownerId       String?         @db.Uuid
  provider      StorageProvider
  bucket        String          @db.VarChar(255)
  objectKey     String          @unique @db.VarChar(1024)
  originalName  String          @db.VarChar(255)
  mimeType      String          @db.VarChar(120)
  byteSize      BigInt
  checksum      String?         @db.VarChar(128)
  status        MediaStatus     @default(PENDING)
  visibility    String          @default("private") @db.VarChar(32)
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  owner         User?           @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  uploadSession UploadSession?

  @@index([ownerId, status, createdAt])
}

model UploadSession {
  id           String          @id @default(uuid()) @db.Uuid
  assetId      String          @unique @db.Uuid
  createdById  String?         @db.Uuid
  provider     StorageProvider
  status       UploadStatus    @default(PENDING)
  objectKey    String          @db.VarChar(1024)
  uploadId     String?         @db.VarChar(255)
  expectedSize BigInt
  expectedHash String?         @db.VarChar(128)
  instructions Json?
  expiresAt    DateTime
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  asset        MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation("UploadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById, status, expiresAt])
}

model ContentItem {
  id             String           @id @default(uuid()) @db.Uuid
  type           ContentType
  slug           String           @unique @db.VarChar(255)
  title          String           @db.VarChar(255)
  part           Int?
  level          Int?
  status         ContentStatus    @default(DRAFT)
  createdById    String           @db.Uuid
  updatedById    String?          @db.Uuid
  currentVersion Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      User             @relation("ContentCreator", fields: [createdById], references: [id])
  updatedBy      User?            @relation("ContentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  versions       ContentVersion[]
  questions      Question[]

  @@index([type, status, part, level])
}

model ContentVersion {
  id            String      @id @default(uuid()) @db.Uuid
  contentItemId String      @db.Uuid
  version       Int
  payload       Json
  createdById   String      @db.Uuid
  createdAt     DateTime    @default(now())
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  createdBy     User        @relation(fields: [createdById], references: [id])

  @@unique([contentItemId, version])
}

model ImportBatch {
  id          String       @id @default(uuid()) @db.Uuid
  createdById String       @db.Uuid
  sourceName  String       @db.VarChar(255)
  schema      String       @db.VarChar(80)
  status      ImportStatus @default(PENDING)
  summary     Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   User         @relation(fields: [createdById], references: [id])
  items       ImportItem[]

  @@index([status, createdAt])
}

model ImportItem {
  id          String      @id @default(uuid()) @db.Uuid
  batchId     String      @db.Uuid
  rowNumber   Int
  externalKey String      @db.VarChar(255)
  status      String      @db.VarChar(32)
  payload     Json
  error       String?
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
}

model Question {
  id            String             @id @default(uuid()) @db.Uuid
  contentItemId String?            @db.Uuid
  kind          QuestionKind
  part          Int?
  level         Int?
  prompt        Json
  answerKey     String?
  explanation   Json?
  status        ContentStatus      @default(DRAFT)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  contentItem   ContentItem?       @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  options       QuestionOption[]
  attempts      QuestionAttempt[]
  progress      QuestionProgress[]
  mockQuestions MockTestQuestion[]
  examAnswers   ExamAnswer[]

  @@index([kind, part, level, status])
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  key        String   @db.VarChar(8)
  text       Json
  sortOrder  Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, key])
  @@index([questionId, sortOrder])
}

model QuestionAttempt {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  questionId     String         @db.Uuid
  context        AttemptContext
  contextId      String?        @db.Uuid
  selectedAnswer String?
  isCorrect      Boolean
  timeMs         Int?
  answerVersion  Int            @default(1)
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id])

  @@index([userId, questionId, createdAt])
  @@index([userId, context, createdAt])
}

model QuestionProgress {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  questionId   String    @db.Uuid
  seenCount    Int       @default(0)
  correctCount Int       @default(0)
  wrongCount   Int       @default(0)
  lastSeenAt   DateTime?
  nextReviewAt DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  targetType String   @db.VarChar(40)
  targetId   String   @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetType, targetId])
}

model SavedItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  targetType String   @db.VarChar(40)
  targetId   String   @db.Uuid
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
}

model StudySession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  surface         String    @db.VarChar(40)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model VocabularyEntry {
  id            String              @id @default(uuid()) @db.Uuid
  lemma         String              @unique @db.VarChar(255)
  pronunciation String?
  partOfSpeech  String?
  meanings      Json
  examples      Json?
  audioAssetId  String?             @db.Uuid
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sets          VocabularySetItem[]
  cards         SrsCard[]
}

model VocabularySet {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique @db.VarChar(255)
  title       String              @db.VarChar(255)
  description String?
  status      ContentStatus       @default(DRAFT)
  items       VocabularySetItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model VocabularySetItem {
  setId     String          @db.Uuid
  entryId   String          @db.Uuid
  sortOrder Int
  set       VocabularySet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  entry     VocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([setId, entryId])
  @@index([setId, sortOrder])
}

model SrsCard {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  entryId        String          @db.Uuid
  state          SrsState        @default(NEW)
  dueAt          DateTime        @default(now())
  intervalDays   Float           @default(0)
  ease           Float           @default(2.5)
  repetitions    Int             @default(0)
  lapses         Int             @default(0)
  lastReviewedAt DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry          VocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([userId, dueAt, state])
}

model MockTest {
  id          String             @id @default(uuid()) @db.Uuid
  slug        String             @unique @db.VarChar(255)
  title       String             @db.VarChar(255)
  durationMin Int
  status      ContentStatus      @default(DRAFT)
  questions   MockTestQuestion[]
  sessions    ExamSession[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model MockTestQuestion {
  testId     String   @db.Uuid
  questionId String   @db.Uuid
  sortOrder  Int
  part       Int?
  test       MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@id([testId, questionId])
  @@unique([testId, sortOrder])
  @@index([testId, part])
}

model ExamSession {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  testId      String            @db.Uuid
  status      ExamSessionStatus @default(ACTIVE)
  mode        String            @db.VarChar(32)
  startedAt   DateTime          @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  test        MockTest          @relation(fields: [testId], references: [id])
  answers     ExamAnswer[]
  result      ExamResult?

  @@index([userId, status, startedAt])
}

model ExamAnswer {
  sessionId      String      @db.Uuid
  questionId     String      @db.Uuid
  selectedAnswer String?
  isCorrect      Boolean?
  answeredAt     DateTime?
  session        ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id])

  @@id([sessionId, questionId])
}

model ExamResult {
  sessionId   String      @id @db.Uuid
  total       Int
  correct     Int
  wrong       Int
  unanswered  Int
  score       Int?
  durationSec Int
  createdAt   DateTime    @default(now())
  session     ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model WritingSubmission {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  promptId    String?       @db.Uuid
  part        Int
  body        String        @db.Text
  wordCount   Int
  status      WritingStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade       WritingGrade?

  @@index([userId, status, createdAt])
}

model WritingGrade {
  submissionId String            @id @db.Uuid
  overall      Float?
  rubric       Json?
  feedback     Json?
  provider     String?           @db.VarChar(80)
  createdAt    DateTime          @default(now())
  submission   WritingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model AiCreditLedger {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  type         CreditEntryType
  amount       Int
  balanceAfter Int
  referenceId  String?         @db.Uuid
  metadata     Json?
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Post {
  id           String     @id @default(uuid()) @db.Uuid
  authorId     String     @db.Uuid
  type         String     @db.VarChar(40)
  content      String     @db.Text
  tags         Json?
  status       PostStatus @default(PUBLISHED)
  likeCount    Int        @default(0)
  commentCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id        String     @id @default(uuid()) @db.Uuid
  postId    String     @db.Uuid
  authorId  String     @db.Uuid
  parentId  String?    @db.Uuid
  content   String     @db.Text
  status    PostStatus @default(PUBLISHED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([postId, status, createdAt])
}

model Reaction {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  kind      String   @db.VarChar(32)
  createdAt DateTime @default(now())

  @@id([userId, postId, kind])
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @db.Uuid
  targetType String       @db.VarChar(32)
  targetId   String       @db.Uuid
  reason     String       @db.Text
  status     ReportStatus @default(OPEN)
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model FriendRequest {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @db.Uuid
  addresseeId String   @db.Uuid
  status      String   @default("PENDING") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model ChatMessage {
  id          String   @id @default(uuid()) @db.Uuid
  authorId    String   @db.Uuid
  recipientId String?  @db.Uuid
  content     String   @db.Text
  replyToId   String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([recipientId, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String           @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model XpLedger {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  amount      Int
  source      String   @db.VarChar(80)
  referenceId String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model DailyGoal {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  targetType String   @db.VarChar(32)
  target     Int
  achieved   Int      @default(0)
  day        DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, targetType, day])
  @@index([userId, day])
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  planCode    PlanCode
  amount      Int
  currency    String      @default("VND") @db.VarChar(3)
  status      OrderStatus @default(PENDING)
  provider    String      @db.VarChar(40)
  providerRef String?     @unique @db.VarChar(255)
  createdAt   DateTime    @default(now())
  paidAt      DateTime?
  updatedAt   DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String    @db.VarChar(40)
  providerEventId String    @db.VarChar(255)
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
}

model ReferralAttribution {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @db.VarChar(80)
  visitorHash    String   @db.VarChar(128)
  referredUserId String?  @db.Uuid
  firstTouchAt   DateTime @default(now())
  expiresAt      DateTime

  @@index([code, expiresAt])
  @@index([referredUserId])
}

model CommissionLedger {
  id             String           @id @default(uuid()) @db.Uuid
  referrerId     String           @db.Uuid
  referredUserId String?          @db.Uuid
  orderId        String?          @db.Uuid
  rate           Float
  amount         Int
  status         CommissionStatus @default(PENDING)
  availableAt    DateTime
  createdAt      DateTime         @default(now())

  @@index([referrerId, status, availableAt])
}

model WithdrawalRequest {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  amount         Int
  status         WithdrawalStatus @default(REQUESTED)
  bankAccountRef String?
  note           String?
  createdAt      DateTime         @default(now())
  processedAt    DateTime?

  @@index([userId, status, createdAt])
}
